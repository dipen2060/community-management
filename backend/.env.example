PORT=5000
MONGO_URI=
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRE=7d
CLIENT_URL=http://localhost:3000
FINE_PER_DAY=10
MAX_FINE=500
MAX_MONTHLY_DUE=10000
EXPORT_MAX_RECORDS=1000
TRUST_PROXY=false
# Serve the interactive API docs at /api-docs and the raw spec at /api-docs.json.
# Defaults to true when NODE_ENV is not "production", false when it is.
ENABLE_API_DOCS=false
# Password every newly created account (admin, staff, resident) starts with.
# They must change it on first login (mustChangePassword is always forced to true).
DEFAULT_USER_PASSWORD=Tole@1234
# Complaint escalation thresholds in hours (positive numbers; decimals allowed).
SLA_URGENT_HOURS=4
SLA_HIGH_HOURS=12
SLA_MEDIUM_HOURS=48
SLA_LOW_HOURS=72
# Valid node-cron expression for checking SLA breaches.
SLA_CHECK_CRON=*/30 * * * *
# Poll tie-break runoff duration (hours) and total maximum rounds, including round 1.
POLL_RUNOFF_HOURS=24
POLL_MAX_ROUNDS=2
